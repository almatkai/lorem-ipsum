{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "lorem-ipsum",
  "title": "Lorem Ipsum",
  "description": "Generate placeholder content",
  "icon": "paragraph-icon.png",
  "author": "almatkai",
  "contributors": [
    "GastroGeek",
    "stelo",
    "enkia",
    "j3lte"
  ],
  "keywords": [
    "generator",
    "paragraphs",
    "sentences",
    "words",
    "text",
    "lorem",
    "ipsum"
  ],
  "platforms": [
    "macOS",
    "Windows"
  ],
  "categories": [
    "Data",
    "Design Tools",
    "Developer Tools",
    "Web"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "paragraphs",
      "title": "Generate Paragraphs",
      "subtitle": "Lorem Ipsum",
      "description": "Generate random paragraphs and copy them to the clipboard",
      "mode": "no-view",
      "arguments": [
        {
          "name": "numberOfParagraphs",
          "type": "text",
          "required": false,
          "placeholder": "No. of paragraphs"
        }
      ],
      "platforms": [
        "macOS",
        "Windows"
      ]
    },
    {
      "name": "sentences",
      "title": "Generate Sentences",
      "subtitle": "Lorem Ipsum",
      "description": "Generate random sentences and copy them to the clipboard",
      "mode": "no-view",
      "arguments": [
        {
          "name": "numberOfSentences",
          "type": "text",
          "required": false,
          "placeholder": "No. of sentences"
        }
      ],
      "platforms": [
        "macOS",
        "Windows"
      ]
    },
    {
      "name": "words",
      "title": "Generate Words",
      "subtitle": "Lorem Ipsum",
      "description": "Generate random words and copy them to the clipboard",
      "mode": "no-view",
      "arguments": [
        {
          "name": "numberOfWords",
          "type": "text",
          "required": false,
          "placeholder": "No. of words"
        }
      ],
      "platforms": [
        "macOS",
        "Windows"
      ]
    },
    {
      "name": "ai-generate",
      "title": "Generate with AI",
      "subtitle": "Lorem Ipsum",
      "description": "Use AI to generate some placeholder text",
      "mode": "no-view",
      "arguments": [
        {
          "name": "topic",
          "type": "text",
          "required": false,
          "placeholder": "any topic"
        }
      ],
      "platforms": [
        "macOS",
        "Windows"
      ]
    }
  ],
  "preferences": [
    {
      "name": "action",
      "type": "dropdown",
      "title": "Default Action",
      "description": "What you would like to happen when running the command",
      "data": [
        {
          "value": "clipboard",
          "title": "Copy to Clipboard"
        },
        {
          "value": "paste",
          "title": "Paste to Active App"
        },
        {
          "value": "pasteAndCopy",
          "title": "Paste and Copy to Clipboard"
        }
      ],
      "default": "clipboard",
      "required": false
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.104.1",
    "lorem-ipsum": "^2.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "id": "com.tezbar.lorem-ipsum",
  "version": "0.1.0",
  "tezbar": {
    "schemaVersion": 1,
    "platforms": [
      "macos",
      "windows"
    ],
    "repository": "https://github.com/almatkai/lorem-ipsum",
    "upstream": {
      "repository": "https://github.com/raycast/extensions",
      "path": "extensions/lorem-ipsum",
      "commit": "6734d85992290066fd31a7f5bee3cca3d3545a1a"
    },
    "linuxStatus": "coming-soon"
  }
}
