{
  "schemaVersion": 3,
  "id": "com.tezbar.native.lorem-ipsum",
  "slug": "lorem-ipsum",
  "name": "Lorem Ipsum",
  "version": "0.1.1",
  "description": "Generate placeholder content",
  "author": "almatkai",
  "icon": "resources/assets/paragraph-icon.png",
  "categories": [
    "Data",
    "Design Tools",
    "Developer Tools",
    "Web"
  ],
  "keywords": [
    "generator",
    "paragraphs",
    "sentences",
    "words",
    "text",
    "lorem",
    "ipsum"
  ],
  "runtime": "rust",
  "execution": "process",
